# Copy this file to ".env" and change the values:  copy .env.example .env
# The real ".env" is ignored by git, so passwords are never committed.

# --- PostgreSQL (pgvector) ---
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me
# Host port. 5440 (not 5432) so it does not clash with other local databases.
POSTGRES_PORT=5440

# --- Ollama (local AI models) ---
OLLAMA_PORT=11440
CHAT_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# Which optional services "docker compose up" starts.
# "ollama" = run local models. Leave empty if you use OpenAI instead.
COMPOSE_PROFILES=ollama

# --- Monitoring (optional): docker compose --profile monitoring up -d ---
PROMETHEUS_PORT=9190
JAEGER_UI_PORT=16690
JAEGER_OTLP_PORT=14318
